# Supabase: Project Settings > Database > Connect > "Session pooler" URI
# (session pooler works as a drop-in replacement for pgx's default config;
# the transaction pooler on port 6543 needs extra pgx setup, don't use it here)
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
JWT_SIGNED_STRING=
LINECLIENTID=

# Single shared secret for POST /auth/admin (manga-tracker-admin's login) —
# replaced the old username/password + admins table. Pick any long random
# string; whoever holds it can log into the admin panel.
ADMINAPIKEY=

# LINE Official Account (Messaging API channel, not the LIFF/login channel
# above) — used by POST /line/webhook. LINE Developers Console > the
# Messaging API channel > "Basic settings" tab > Channel secret.
LINECHANNELSECRET=
# Same channel > "Messaging API" tab > Channel access token (issue one).
LINECHANNELACCESSTOKEN=

# Publishes a {"user_id": ...} message after every rate/unrate, so the
# Python recommender service (Pub/Sub -> Cloud Run) can refresh that
# user's recommendations. GCP Console project number/ID that owns the
# topic below (needed explicitly — this isn't always running on GCP
# infra with implicit project detection available).
GCPPROJECTID=
# Pub/Sub topic name (not full path) to publish to, e.g. manga-rating-updated.
# Left empty, publishing is skipped (logged, not an error) rather than
# failing the rating request.
PUBSUBRATINGTOPIC=
